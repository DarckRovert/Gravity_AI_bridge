# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  GRAVITY AI — Caddy Reverse Proxy Configuration                              ║
# ║                                                                              ║
# ║  INSTALACIÓN:                                                                ║
# ║    1. Descarga Caddy: https://caddyserver.com/download (Windows)             ║
# ║    2. Coloca caddy.exe en la raíz del proyecto                               ║
# ║    3. Para desarrollo local: caddy run --config Caddyfile                    ║
# ║    4. Para producción con dominio: edita "localhost" por tu dominio           ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── MODO DESARROLLO (sin dominio) ─────────────────────────────────────────────
# Caddy escucha en HTTPS en localhost:443 con certificado auto-firmado.
# El navegador mostrará una advertencia de seguridad (normal en dev).

localhost {
    # Proxy inverso al servidor Gravity en el puerto configurado
    reverse_proxy localhost:7860 {
        health_uri      /v1/health
        health_interval 30s
        health_timeout  5s
    }

    # Headers de seguridad
    header {
        X-Content-Type-Options  nosniff
        X-Frame-Options         DENY
        X-XSS-Protection        "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Eliminar header que revela el servidor
        -Server
    }

    # Comprimir respuestas grandes
    encode gzip

    # Log de acceso
    log {
        output file logs/caddy_access.log {
            roll_size   10mb
            roll_keep   5
        }
    }
}

# ── MODO PRODUCCIÓN (con dominio propio) ──────────────────────────────────────
# Descomenta y edita cuando tengas un dominio. Caddy obtiene el certificado
# SSL de Let's Encrypt automáticamente (gratis).
#
# gravity.tudominio.com {
#     reverse_proxy localhost:7860 {
#         health_uri      /v1/health
#         health_interval 30s
#         health_timeout  5s
#     }
#
#     header {
#         X-Content-Type-Options  nosniff
#         X-Frame-Options         DENY
#         Strict-Transport-Security "max-age=31536000; includeSubDomains"
#         -Server
#     }
#
#     encode gzip
#
#     # Rate limiting básico (requiere plugin: caddy-ratelimit)
#     # rate_limit {
#     #     zone gravity_api {
#     #         key {remote_host}
#     #         events 60
#     #         window 1m
#     #     }
#     # }
#
#     log {
#         output file logs/caddy_access.log {
